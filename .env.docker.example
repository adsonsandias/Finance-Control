# Docker Environment Variables for Production
# Copy this file to .env.docker and configure for your production environment

# Database Configuration
POSTGRES_DB=finance_control_prod
POSTGRES_USER=finance_user
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
POSTGRES_PORT=5432

# Backend Configuration
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_SECRET_AT_LEAST_32_CHARS
PORT=3001
NODE_ENV=production
CORS_ORIGIN=https://your-production-domain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Frontend Configuration
REACT_APP_API_URL=https://api.your-production-domain.com/api

# Optional: SSL Configuration
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem

# Optional: Monitoring
# LOG_LEVEL=info
# ENABLE_METRICS=true