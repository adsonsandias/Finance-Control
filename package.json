{
  "name": "finance-control-monorepo",
  "version": "1.3.0",
  "description": "A modern, full-stack financial management application with micro frontend architecture",
  "private": true,
  "workspaces": [
    "apps/frontend/*",
    "apps/backend",
    "packages"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:web\"",
    "dev:backend": "cd apps/backend && npm run dev",
    "dev:web": "cd apps/frontend/web && npm start",
    "dev:mobile": "cd apps/frontend/mobile && npm start",
    "build": "npm run build:web && npm run build:mobile && npm run build:backend",
    "build:web": "cd apps/frontend/web && npm run build",
    "build:mobile": "cd apps/frontend/mobile && npm run build",
    "build:backend": "cd apps/backend && npm run build",
    "test": "npm run test:web && npm run test:mobile && npm run test:backend",
    "test:web": "cd apps/frontend/web && npm test",
    "test:mobile": "cd apps/frontend/mobile && npm test",
    "test:backend": "cd apps/backend && npm test",
    "test:e2e": "concurrently \"cd apps/frontend/web && npm run test:e2e\" \"cd apps/frontend/mobile && npm run test:e2e\"",
    "test:e2e:web": "cd apps/frontend/web && npm run test:e2e",
    "test:e2e:mobile": "cd apps/frontend/mobile && npm run test:e2e",
    "test:e2e:open": "cd apps/frontend/web && npm run test:e2e:open",
    "test:e2e:open:mobile": "cd apps/frontend/mobile && npm run test:e2e:open",
    "install:all": "npm install && npm run install:modules",
    "install:modules": "cd apps/frontend/web && npm install && cd ../mobile && npm install && cd ../../backend && npm install && cd ../../packages && npm install"
  },
  "devDependencies": {
    "concurrently": "^7.6.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/finance-control.git"
  },
  "keywords": [
    "finance",
    "react",
    "typescript",
    "micro-frontend",
    "nodejs",
    "postgresql"
  ],
  "webor": "Adson Santos",
  "license": "MIT"
}
